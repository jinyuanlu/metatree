# direnv config for metatree development.
#
# Install direnv:  brew install direnv  +  shell hook (https://direnv.net/)
# Then in this directory:  direnv allow

# Put bin/ on PATH so `mt`, `mt-test`, `mt-bats` work as bare commands.
PATH_add bin

# Use a dev-local config so iteration never touches ~/.config/mt/config.toml.
# .mt.dev.toml is gitignored — edit freely, set repos_dirs to your test paths.
export MT_CONFIG="$PWD/.mt.dev.toml"

# Seed a starter dev config on first entry (idempotent).
if [[ ! -f .mt.dev.toml ]]; then
  cat > .mt.dev.toml <<'EOF'
# metatree dev config — gitignored. Edit freely.
repos_dirs      = ["~/Code"]
tmux_session    = "mt-dev"
tmux_window     = "dashboard"
branch_prefix   = "mt-dev"
default_backend = "claude"
ollama_model    = "llama3:8b"
EOF
fi

cat <<EOF
metatree dev shell ready.
  mt        run local mt.sh from $PWD
  mt-test   run smoke integration test (≈3s)
  mt-bats   run bats unit tests (needs: brew install bats-core)
  config    $MT_CONFIG
EOF
